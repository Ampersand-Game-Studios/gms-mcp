{
  "description": "GameMaker project startup context and compile/run failure surfacing",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__plugin_gms-mcp_gms__(gm_run|gm_compile)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify-errors.sh"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__plugin_gms-mcp_gms__(gm_run|gm_compile)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/notify-errors.sh"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
