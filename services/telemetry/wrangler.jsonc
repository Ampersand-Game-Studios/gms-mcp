{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gms-mcp-telemetry-ingest",
  "account_id": "d64cf4ae4c65526f1c6428babed3c56e",
  "main": "src/index.js",
  "compatibility_date": "2026-03-20",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "ratelimits": [
    { "name": "INGEST_IP_LIMITER", "namespace_id": "761301", "simple": { "limit": 60, "period": 60 } },
    { "name": "INGEST_EDGE_LIMITER", "namespace_id": "761302", "simple": { "limit": 300, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "INGEST_BUDGET", "class_name": "IngestBudget" }] },
  "migrations": [{ "tag": "ingest-budget-v1", "new_sqlite_classes": ["IngestBudget"] }],
  "routes": [{ "pattern": "gms-mcp-telemetry.ampersandgamestudios.com", "custom_domain": true }],
  "vars": { "RAW_RETENTION_DAYS": "90", "AGGREGATE_RETENTION_MONTHS": "24" },
  "r2_buckets": [{ "binding": "TELEMETRY_BUCKET", "bucket_name": "gms-mcp-telemetry-prod" }],
  "queues": {
    "producers": [{ "binding": "TELEMETRY_QUEUE", "queue": "gms-mcp-telemetry-events" }],
    "consumers": [{ "queue": "gms-mcp-telemetry-events", "max_batch_size": 50, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "gms-mcp-telemetry-events-dlq" }]
  },
  "triggers": { "crons": ["15 2 * * *"] }
}
